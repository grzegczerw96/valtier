---
/** Home stage: the light editorial hero (WebGL depth portrait with a CRT video in
 *  its sunglasses) that tilts away on a slanted wipe to reveal the Signature
 *  Moments rail, then the quote that arrives as a zooming dot matrix.
 *  Desktop: one pinned scene (150vh per moment) driven by ./stage.ts.
 *  Phones: the same pieces in native flow (hero, slanted moments rail). */
import TiltCard from '@valtier/ds/components/TiltCard.astro';
import WordMarquee from '@valtier/ds/components/WordMarquee.astro';
import Signature from '@valtier/ds/components/Signature.astro';
import { withBase } from '@valtier/ds/lib/base';
import Logo from '@valtier/ds/components/Logo.astro';
import { HAMBURGER } from '@valtier/ds/motion/menu';
import { hero, moments, quote } from '../../content/home';

const items = moments.items;
const n = Math.max(5, items.length);
const first = items[0];
const yOffsets = [-10, 12, -15, 8, -5];
const HASH = ['hash', 'hash', 'hash', 'hash', 'line', 'hash', 'hash', 'hash', 'hash'] as const;
const yard: (string | number)[] = [...HASH, ...[10, 20, 30, 40, 50, 40, 30, 20, 10].flatMap((y) => [y, ...HASH])];
const words = [
  { src: withBase('/svg/word-nico.svg'), aspect: 3.87 },
  { src: withBase('/svg/word-valtier.svg'), aspect: 7.419 },
] as [{ src: string; aspect: number }, { src: string; aspect: number }];
const chars = Array.from(hero.storyCopy);
---
<section class="hs" data-section="home-stage" data-home-stage style={`--sig-n:${n}`}>
  <div class="hs__pin" data-home-pin>
    <!-- ======== HERO (tilts away on the wipe) ======== -->
    <div class="hs__hero" data-hero-fade>
      <div class="hero-window" data-hero-window>
        <div class="hero-window__content">
          <section class="hero" data-hero data-theme="tone-light" aria-labelledby="hero-title">
            <h1 id="hero-title" class="sr-only">{hero.name}</h1>
            <p class="sr-only">{hero.storyCopy}</p>
            <video class="hero__video" data-hero-video muted loop playsinline preload="none" disableremoteplayback aria-hidden="true" crossorigin="anonymous"
              data-src={hero.video.desktop} data-src-phone={hero.video.phone}></video>
            <div class="hero__bg" aria-hidden="true">
              <div class="hero__base"></div>
              <div class="hero__screen"></div>
              <WordMarquee rows={words} />
            </div>
            <div class="hero__light" aria-hidden="true"></div>
            <div class="hero__portrait hero-scale" aria-hidden="true">
              <img class="hero__still" data-hero-still src={hero.portrait.still} alt="" width={hero.portrait.width} height={hero.portrait.height} fetchpriority="high" decoding="async" />
              <canvas class="hero__gl" data-hero-gl></canvas>
            </div>
            <div class="hero__wordmark" data-hero-wordmark>
              <div class="hero-scale"><span class="hero__wordmark-svg" role="img" aria-label={hero.name}></span></div>
            </div>
            <div class="hero__chrome" data-hero-chrome>
              <div class="hero-phone hero-scale" aria-hidden="true">
                <div class="hero-phone__row">
                  <p class="hero-phone__copy" data-hero-copy-ph>{chars.map((c) => <span data-ch>{c}</span>)}</p>
                  <div class="hero-phone__sig"><Signature class="hero__sig-svg" color="#502E84" label="Nico Valtier signature" /></div>
                </div>
              </div>
              <div class="hero-side hero-side--left hero-scale">
                <div class="hero-col">
                  <div class="hero-col__above">
                    <div class="hero-card" data-hero-card role="button" tabindex="0" aria-label={`Open ${first.title}`} style={`aspect-ratio:${first.w}/${first.h}`}>
                      <div class="tilt-body"><TiltCard src={first.image} width={first.w} height={first.h} loading="eager" /></div>
                    </div>
                  </div>
                  <p class="hero-col__text">{hero.cardCopy}</p>
                </div>
              </div>
              <div class="hero-side hero-side--right hero-scale">
                <div class="hero-col">
                  <div class="hero-col__above hero-col__above--sig">
                    <Signature class="hero__sig" color="#502E84" label="Nico Valtier signature" />
                  </div>
                  <p class="hero-col__text" aria-hidden="true" data-hero-copy>{chars.map((c) => <span data-ch>{c}</span>)}</p>
                </div>
              </div>
            </div>
            <button type="button" class="hero__zoom" data-hero-zoom aria-label="Zoom into the glasses" hidden></button>
            <button type="button" class="hero__zoom-out" data-hero-zoom-out aria-label="Zoom back out" hidden></button>
            <div class="hero__hint" data-hero-hint aria-hidden="true"><span data-hint-label>Scroll</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg></div>
          </section>
        </div>
      </div>
    </div>

    <!-- ======== SIGNATURE MOMENTS ======== -->
    <div class="hs__moments" data-home-moments data-tone-phone="dark">
      <div class="sm-backdrop" data-sm-backdrop data-theme="tone-dark">
        <div class="sm-headline" data-sm-headline aria-hidden="true"><h2 class="display">{moments.heading}</h2></div>
        <div class="sm-grass" aria-hidden="true"></div>
        <div class="sm-light" data-sm-light aria-hidden="true"></div>
      </div>
      <h2 class="sr-only">{moments.heading}</h2>
      <div class="sm-yards" data-sm-yards aria-hidden="true">
        {yard.map((y) => y === 'hash' ? (
          <div class="sm-hash"><span></span><span></span><span></span></div>
        ) : y === 'line' ? (
          <div class="sm-line"></div>
        ) : (
          <div class="sm-yard"><i></i><span>{y}</span></div>
        ))}
      </div>
      <canvas class="hs__dots" data-quote-canvas aria-hidden="true"></canvas>
      <div class="sm-cards" data-sm-cards role="list" aria-label={moments.heading}>
        {items.map((m, i) => (
          <div class="sm-card" data-sm-card role="listitem" style={`--i:${i};--yo:${yOffsets[i % yOffsets.length]};--fd:${(6.4 + (i % 3) * 1.1).toFixed(1)}s;--fdl:${(-1.27 * i).toFixed(2)}s`}>
            <div class="sm-card__inner">
              <div class="sm-card__box" data-card-box role="button" tabindex="0" aria-label={`Open ${m.title}`} data-cursor="Watch" style={`aspect-ratio:${m.w}/${m.h}`}>
                <div class="sm-card__3d" data-card-3d>
                  <div class="tilt-body sm-card__body"><TiltCard src={m.image} alt={m.title} width={m.w} height={m.h} /></div>
                  <div class="sm-card__player" data-card-player hidden>
                    <div class="sm-card__screen" style={`--cw:${m.w};--ch:${m.h}`}>
                      <video muted loop playsinline preload="none" disableremoteplayback data-src={m.video ?? hero.video.desktop}></video>
                      <button type="button" class="sm-card__close" data-card-close aria-label="Close video"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 2l10 10M12 2 2 12" /></svg></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="sm-card__title" data-card-title>
                <p class="label">{m.title}</p>
                <p class="label-sm">{m.stat}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Hero card in flight to the first slot (desktop). -->
    <div class="hs__flight" data-flight aria-hidden="true" style="visibility:hidden">
      <div class="hs__flight-spin" data-flight-spin>
        <TiltCard src={first.image} width={first.w} height={first.h} loading="eager" />
        <TiltCard src={first.image} width={first.w} height={first.h} loading="eager" back />
      </div>
    </div>
  </div>
</section>

<!-- Quote that zooms out of a dot matrix (desktop: fixed overlay; phones: inside quote-photos). -->
<div class="hq" data-quote aria-hidden="true">
  <div class="hq__wrap" data-quote-wrap>
    <img class="hq__marks" data-quote-marks src={withBase('/svg/quotes.svg')} alt="" width="116" height="42" />
    <h2 class="display hq__title" data-quote-title>
      {quote.lines.map((l) => <span class="hq__line" data-dz-line>{l}</span>)}
    </h2>
    <p class="hq__desc" data-quote-desc>{quote.body}</p>
  </div>
</div>

<!-- Duplicate nav (light) shown below the slanted cut while the hero wipes away. -->
<div class="wipe-nav" data-home-wipe-nav aria-hidden="true">
  <div class="wipe-nav__row">
    <span class="wipe-nav__logo"><Logo class="wipe-nav__logo-svg" /></span>
    <span class="wipe-nav__burger"><svg viewBox="0 0 30 13" fill="currentColor"><path d={HAMBURGER.top} /><path d={HAMBURGER.bot} /></svg></span>
  </div>
</div>

<script>
  window.vDefer(async () => {
    const { initHomeStage } = await import('./stage');
    await window.vIdle();
    initHomeStage();
  });
</script>

<style is:global>
  /* ---------------------------------------------------------------- stage */
  .hs { position: relative; width: 100%; height: calc(150vh * var(--sig-n)); --home-pane: 100svh; }
  .hs__pin { position: sticky; top: 0; height: 100svh; width: 100%; overflow: clip; touch-action: pan-y; --vu: var(--vu-fit); }
  .hs__hero { position: absolute; inset: 0; z-index: 40; pointer-events: none; transform: translate3d(0, 0, 0); backface-visibility: hidden; }

  .hero-window {
    position: absolute; inset: -100vmax -100vmax 0; overflow: hidden; pointer-events: none;
    transform-origin: 100vmax 100%;
    transform: translateY(calc(var(--wipe, 0) * -1.2 * var(--wipe-pane))) rotate(var(--wipe-angle, 0deg));
    will-change: transform;
  }
  .hero-window__content {
    position: absolute; inset: 100vmax 100vmax 0; pointer-events: auto;
    transform-origin: 0 100%;
    transform: rotate(calc(-1 * var(--wipe-angle, 0deg))) translateY(calc(var(--wipe, 0) * 1.2 * var(--wipe-pane)));
    will-change: transform;
  }
  .hero-scale { transform: scale(calc(1 - var(--wipe, 0) * .18)); transform-origin: center bottom; will-change: transform; }

  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative; display: flex; align-items: flex-end; width: 100%; height: 100%; min-height: 100svh; overflow: hidden;
    color: var(--theme-fg);
    --hero-u: clamp(12px, calc(var(--vu) * 14 / 14.4), 22px);
    --hero-m: clamp(8px, calc(var(--vu) * 14 / 14.4), 22px);
    --hero-pu: clamp(12px, calc(var(--pu) * 3.2), 14px);
  }
  .hero__video { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; left: 0; top: 0; }
  .hero__bg { position: absolute; inset: 0; overflow: hidden; }
  .hero__bg > div:not(.wmq) { position: absolute; inset: 0; }
  .hero__base { background: var(--color-sand); }
  .hero__screen {
    background: url('/textures/pebble.webp') 0 0 / var(--pebble-tile) var(--pebble-tile) repeat;
    mix-blend-mode: screen;
  }
  .hero__light {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background: url('/textures/light-wash.webp') center / cover no-repeat; mix-blend-mode: soft-light;
  }
  .hero__portrait { position: absolute; inset: 0; z-index: 30; pointer-events: none; }
  .hero__still {
    position: absolute; left: 50%; bottom: -6%; height: 83%; width: auto; max-width: none; translate: -50% 0;
    transition: opacity .4s ease;
  }
  @media (min-width: 768px) { .hero__still { height: 98%; } }
  .hero[data-gl-ready] .hero__still { opacity: 0; visibility: hidden; transition: none; }
  .hero__gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; }

  .hero__wordmark {
    position: fixed; inset: 0 0 auto; z-index: 50; pointer-events: none;
    display: flex; align-items: center; justify-content: center; padding: 1.75rem 1.5rem;
  }
  @media (min-width: 768px) { .hero__wordmark { padding: 2.25rem 3rem; } }
  .hero__wordmark-svg {
    display: block; height: .8rem; aspect-ratio: 5.82; /* cap height of a 1rem / 1.25rem wordmark */ background-color: var(--logo-color, #171220);
    -webkit-mask: url('/svg/wordmark.svg') center / contain no-repeat; mask: url('/svg/wordmark.svg') center / contain no-repeat;
  }
  @media (min-width: 768px) { .hero__wordmark-svg { height: 1rem; } }

  .hero__chrome { display: contents; }
  .hero-side {
    position: absolute; top: 0; bottom: 0; z-index: 20; width: 100%; max-width: 456px; pointer-events: none; display: none;
  }
  .hero-side--left { left: var(--page-x); }
  .hero-side--right { right: var(--page-x); }
  @media (min-width: 1024px) and (orientation: landscape) { .hero-side { display: block; } }
  .hero-col {
    position: absolute; width: 21ch; max-width: 100%;
    font-size: calc(var(--hero-u) * 15.12 / 14);
    top: max(calc(88px + 17 * var(--hero-m)), min(74%, calc(20% + 34 * var(--page-w) / 100), calc(54.6% + 30.5 * var(--page-w) / 100 - (48px + 14 * var(--hero-u)) / 1.64 - 6.875 * var(--hero-u) - 16px), calc(100% - 76px - 6.875 * var(--hero-u))));
  }
  .hero-side--left .hero-col { left: 3rem; }
  .hero-side--right .hero-col { right: 3rem; }
  .hero-col__above { position: absolute; bottom: 100%; left: 0; width: 100%; margin-bottom: calc(var(--hero-m) * 24 / 14); }
  .hero-col__text { font-size: var(--hero-u); line-height: 1.375; letter-spacing: .005em; color: var(--theme-fg); text-wrap: wrap; }
  .hero-col__text [data-ch] { visibility: hidden; }
  html:not(.js) .hero-col__text [data-ch], .hero[data-intro-done] .hero-col__text [data-ch] { visibility: visible; }
  .hero__sig { margin-left: calc(var(--hero-m) * -4 / 14); width: calc(var(--hero-m) * 204.8 / 14); height: calc(var(--hero-m) * 172.8 / 14); }

  .hero-card {
    pointer-events: auto; width: calc(var(--hero-m) * 144 / 14); cursor: pointer; perspective: 1500px; outline: none;
  }
  .hero-card:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 4px; }

  .hero-phone { display: none; position: absolute; inset: 0; z-index: 20; pointer-events: none; }
  .hero-phone__row { position: absolute; left: 1.5rem; right: 1.5rem; top: 11.5lvh; display: flex; align-items: flex-start; justify-content: space-between; gap: calc(var(--hero-pu) * 12 / 12.5); }
  .hero-phone__copy { width: 27ch; flex-shrink: 1; text-align: left; font-size: var(--hero-pu); line-height: 1.375; letter-spacing: .005em; color: var(--theme-fg); }
  .hero-phone__copy [data-ch] { opacity: 0; }
  html:not(.js) .hero-phone__copy [data-ch], .hero[data-intro-done] .hero-phone__copy [data-ch] { opacity: 1; }
  .hero-phone__sig { flex-shrink: 0; margin-top: calc(var(--hero-pu) * -6 / 12.5); }
  .hero__sig-svg { width: calc(var(--hero-pu) * 89.6 / 12.5); height: calc(var(--hero-pu) * 75.2 / 12.5); pointer-events: none; }
  @media (max-width: 767px), (max-width: 900px) and (pointer: coarse) { .hero-phone { display: block; } }
  @media (orientation: landscape) and (max-height: 600px) { .hero-phone { display: none; } }

  .hero__zoom, .hero__zoom-out { position: absolute; z-index: 31; display: block; background: transparent; border: 0; }
  .hero__zoom { left: calc(50% - 22.4vh); top: 29%; width: 44.8vh; height: 19%; border-radius: 9999px; cursor: pointer; }
  .hero__zoom-out { inset: 0; cursor: default; }
  .hero__hint {
    position: absolute; inset: auto 0 0; z-index: 32; height: clamp(220px, 34vh, 360px); pointer-events: none;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 2rem; color: #f6f3ef;
    background: radial-gradient(42% 36% at 50% 78%, rgba(0,0,0,.44) 0%, rgba(0,0,0,.22) 42%, rgba(0,0,0,0) 78%), radial-gradient(135% 118% at 50% 122%, rgba(0,0,0,.5) 0%, rgba(0,0,0,.34) 26%, rgba(0,0,0,.18) 46%, rgba(0,0,0,.06) 66%, rgba(0,0,0,0) 84%);
    text-shadow: 0 0 1px rgba(0,0,0,.95), 0 1px 3px rgba(0,0,0,.95), 0 0 9px rgba(0,0,0,.7), 0 0 18px rgba(0,0,0,.5);
    opacity: 0; transition: opacity .3s ease-out;
  }
  .hero__hint[data-on] { opacity: 1; transition-duration: .7s; }
  .hero__hint span { font-size: .72rem; font-weight: 500; text-transform: uppercase; letter-spacing: .42em; padding-left: .42em; }
  .hero__hint svg { margin-top: .5rem; animation: hint-bob 1.8s ease-in-out infinite; filter: drop-shadow(0 1px 2px rgba(0,0,0,.95)) drop-shadow(0 0 6px rgba(0,0,0,.65)); }
  @media (min-width: 768px) { .hero__hint { padding-bottom: 2.5rem; } .hero__hint span { font-size: .8rem; } }
  @keyframes hint-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }

  /* ---------------------------------------------------------------- moments */
  .hs__moments { display: contents; }
  .sm-backdrop { position: absolute; inset: 0; overflow: hidden; isolation: isolate; background-color: var(--color-ink-deep); }
  .sm-headline { position: absolute; inset: 0 0 auto; z-index: 5; overflow: hidden; pointer-events: none; }
  .sm-headline h2 {
    white-space: nowrap; text-align: center; padding-top: calc(.015 * var(--home-pane, 100vh));
    /* Our display face runs ~12.6% wider than the reference's: keep the cap height, match the width. */
    transform: scaleX(var(--display-squeeze, .874)); transform-origin: 50% 0;
    font-size: max(min(80px, 12vw), calc(21.76 * var(--vu))); letter-spacing: -.03em; line-height: .83;
    color: transparent; -webkit-background-clip: text; background-clip: text;
    background-image: var(--sm-grass, linear-gradient(transparent, transparent)), linear-gradient(to bottom, var(--sm-color, var(--color-purple-rich)) var(--sm-solid, 49%), color-mix(in oklab, var(--sm-color, var(--color-purple-rich)) var(--sm-tail, 0%), transparent) 100%);
    background-blend-mode: soft-light, normal; background-size: 170px, 100% 100%; background-repeat: repeat, no-repeat;
  }
  .sm-grass { position: absolute; inset: 0; z-index: 8; pointer-events: none; background: url('/textures/grass.webp') 0 0 / var(--grass-tile) repeat; mix-blend-mode: multiply; }
  .sm-light {
    position: absolute; inset: 0; z-index: 25; pointer-events: none;
    background: url('/textures/light-spot.webp') center / cover no-repeat; mix-blend-mode: soft-light;
    opacity: calc(var(--wipe, 1) * .55 * var(--sm-light-fade, 1)); will-change: opacity;
  }
  .sm-yards {
    position: absolute; top: 0; left: 0; z-index: 15; height: 100%; width: calc(76vw * var(--sig-n, 5)); pointer-events: none;
    display: flex; align-items: center; justify-content: space-between; padding-inline: 2vw; will-change: transform;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.4) 50%, #000 100%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.4) 50%, #000 100%);
  }
  .sm-hash { display: flex; flex-direction: column; align-items: center; justify-content: space-between; width: 0; height: 100%; flex-shrink: 0; }
  .sm-hash span { display: block; width: 1px; height: calc(.025 * var(--home-pane, 100vh)); background: var(--color-bone); opacity: .18; }
  .sm-line { width: 1px; height: 100%; flex-shrink: 0; background: var(--color-bone); opacity: .1; }
  .sm-yard { position: relative; width: 0; height: 100%; flex-shrink: 0; }
  .sm-yard i { position: absolute; inset: 0 auto; left: 50%; width: 1px; translate: -50% 0; background: var(--color-bone); opacity: .14; }
  .sm-yard span {
    position: absolute; left: 50%; translate: -50% 0; white-space: nowrap; bottom: max(13%, calc(50% - 23.125 * var(--vu) - var(--sig-drop, 0px)));
    font-family: var(--font-display); font-weight: 300; font-variation-settings: 'wdth' 50, 'wght' 300; font-size: clamp(48px, calc(9 * var(--vu)), 131px);
    letter-spacing: .07em; line-height: 1; color: var(--color-bone); opacity: .12;
  }
  .hs__dots { position: absolute; left: 0; top: 0; z-index: 20; pointer-events: none; }
  .sm-cards {
    position: absolute; top: 0; bottom: 0; left: 0; z-index: 30; display: flex; align-items: center; user-select: none;
    gap: calc(16 * var(--page-w) / 100); padding-left: calc(14 * var(--page-w) / 100); padding-right: calc(8 * var(--page-w) / 100);
    padding-top: calc(2 * var(--sig-drop, 0px)); perspective: 1200px; will-change: transform;
  }
  .sm-card {
    flex-shrink: 0; display: flex; flex-direction: column; align-items: center;
    width: min(calc(24 * min(1vw, 1.6 * var(--home-pane, 100vh) / 100)), calc(.28 * var(--home-pane, 100vh)));
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }
  @media (min-width: 1280px) { .sm-card { width: calc(16 * var(--vu)); } }
  .sm-card__inner { display: flex; flex-direction: column; align-items: center; width: 100%; transform: translateY(calc(var(--yo) * min(var(--home-pane, 100vh) / 100, var(--vu) * .625))); }
  .sm-card__box {
    position: relative; width: 100%; cursor: pointer; perspective: 1500px; outline: none;
    animation: sm-float var(--fd, 7s) ease-in-out var(--fdl, 0s) infinite;
  }
  .sm-card__box:focus-visible .sm-card__body { outline: 2px solid var(--color-gold); outline-offset: 4px; border-radius: 4%; }
  @keyframes sm-float { 0%, 100% { transform: translateY(1.3%); } 50% { transform: translateY(-1.3%); } }
  .sm-card__3d {
    position: absolute; left: 50%; top: 50%; border-radius: 4%; transform-style: preserve-3d;
    width: calc(100% * var(--open-fw, 1)); height: calc(100% * var(--open-fh, 1));
    transform: translate(-50%, -50%) translateY(calc(var(--open-ty, 0) * 1px)) scale(var(--open-scale, 1)) rotateY(calc(var(--open-ry, 0) * 1deg)) rotateZ(calc(var(--open-rz, 0) * 1deg));
  }
  .sm-card__body { position: absolute; inset: 0; opacity: clamp(0, calc(90 - var(--open-ry, 0)), 1); }
  .sm-card__player {
    position: absolute; inset: 0; isolation: isolate; overflow: hidden; background: var(--color-ink);
    transform: rotateY(180deg); backface-visibility: hidden;
    opacity: clamp(0, calc(var(--open-ry, 0) - 90), 1);
    border-radius: calc(16px / var(--open-scale, 1)); clip-path: inset(0 round calc(16px / var(--open-scale, 1)));
  }
  .sm-card__screen {
    position: absolute; left: 50%; top: 50%; overflow: hidden; transform: translate(-50%, -50%) rotateZ(90deg);
    width: calc(100% * var(--ch) / var(--cw) * var(--open-fh, 1) / var(--open-fw, 1));
    height: calc(100% * var(--cw) / var(--ch) * var(--open-fw, 1) / var(--open-fh, 1));
  }
  .sm-card__screen video { width: 100%; height: 100%; object-fit: cover; }
  .sm-card__close {
