---
/** Page title fitted to the gutter width (re-fit on resize / font load, see
 *  motion/fit-title.ts). Taupe ink that fades out towards its feet; it sits under the
 *  screened pebble grain, so the leather shows through the letters. The display face
 *  has taller caps than the reference's, so for the same width and letter height it
 *  is set ~10% smaller, barely squeezed (.97), with a looser line box (.9 vs .83). */
interface Props { text: string }
const { text } = Astro.props;
---
<div class="pt-title" data-section="pt-title">
  <div class="pt-title__box" data-lane-title style="--squeeze:0.97">
    <h1 class="display pt-title__text" data-lane-title-text>{text}</h1>
  </div>
</div>

<script>
  window.vDefer(async () => {
    const { initAllFitTitles } = await import('@valtier/ds/motion/fit-title');
    initAllFitTitles(document.querySelector('.pt-title') ?? document);
  });
</script>

<style>
  .pt-title {
    position: relative; z-index: -1; padding: clamp(44px, 6vh, 76px) var(--pt-gutter) 0;
    pointer-events: none; user-select: none;
  }
  @media (max-width: 900px) and (pointer: coarse) { .pt-title { padding-top: 96px; } }
  .pt-title__box { width: 100%; }
  .pt-title__text {
    width: max-content; white-space: nowrap; margin: 0;
    /* first paint before the fit: 13 page units, squeezed */
    font-size: calc(13 * var(--page-w) / 100 / var(--squeeze, 1));
    line-height: 0.9; letter-spacing: -0.03em; color: #6e6354;
    transform: scaleX(var(--squeeze, 1)); transform-origin: 0 50%;
    -webkit-mask-image: linear-gradient(to bottom, #000 36%, var(--title-fade-end, rgba(0, 0, 0, 0)) 90%);
    mask-image: linear-gradient(to bottom, #000 36%, var(--title-fade-end, rgba(0, 0, 0, 0)) 90%);
  }
  @media (max-width: 520px) { .pt-title__text { --title-fade-end: rgba(0, 0, 0, 0.35); } }
</style>
