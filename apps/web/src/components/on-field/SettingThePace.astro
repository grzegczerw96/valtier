---
import DotReveal from '@valtier/ds/components/DotReveal.astro';
import SocialIcon, { PLATFORM_LABEL } from '@valtier/ds/components/SocialIcon.astro';
import { pace } from '../../content/on-field';
import { site } from '../../site.config';
const BLUR = [
  { blur: 1, stop: 0 }, { blur: 2, stop: 20 }, { blur: 3.2, stop: 42 }, { blur: 4.8, stop: 62 }, { blur: 7, stop: 80 },
];
const Card = (copy: number) => pace.reels.map((r) => ({ ...r, copy }));
---
<section class="pace cv-auto" style="--cv-h:1000px" data-section="on-pace" data-tone="dark" aria-label={pace.heading} data-pace>
  <div class="pace__head">
    <h2 class="display pace__title"><DotReveal>{pace.heading}</DotReveal></h2>
  </div>

  <div class="pace__stage" data-pace-stage>
    <div class="pace__track" data-pace-track>
      {[0].map((copy) => (
        <div class="pace__set" data-pace-set>
          {Card(copy).map((r) => (
            <div class="pace__card" data-pace-card>
              <a href={r.url} target="_blank" rel="noreferrer" tabindex={copy ? -1 : undefined} draggable="false"
                aria-label={`Watch on ${r.platform === 'tiktok' ? 'TikTok' : 'Instagram'}`} class="pace__link">
                <img src={r.thumb} alt="" width="438" height="856" loading="lazy" decoding="async" draggable="false" />
                {r.video && <video data-reel muted loop playsinline preload="none" data-src={r.video}></video>}
                <span class="pace__badge" aria-hidden="true"><SocialIcon platform={r.platform} class="pace__badge-icon" /></span>
                <span class="pace__dim" aria-hidden="true"></span>
              </a>
            </div>
          ))}
        </div>
      ))}
    </div>
    {['left', 'right'].map((side) => (
      <div class={`pace__edge pace__edge--${side}`} aria-hidden="true">
        {BLUR.map((b, i) => (
          <div class:list={['pace__blur', i < BLUR.length - 2 && 'pace__blur--fine']}
            style={`backdrop-filter:blur(${b.blur}px);-webkit-backdrop-filter:blur(${b.blur}px);-webkit-mask-image:linear-gradient(to ${side}, transparent ${b.stop}%, black ${Math.min(b.stop + 24, 100)}%);mask-image:linear-gradient(to ${side}, transparent ${b.stop}%, black ${Math.min(b.stop + 24, 100)}%)`}></div>
        ))}
      </div>
    ))}
  </div>

  <div class="pace__social">
    {site.socialLinks.map((s) => (
      <a href={s.url} target="_blank" rel="noreferrer" aria-label={PLATFORM_LABEL[s.platform]} class="pace__social-link"><SocialIcon platform={s.platform} class="pace__social-icon" /></a>
    ))}
  </div>
</section>

<script>
  window.vDefer(async () => {
    const { initDrift } = await import('@valtier/ds/motion/drift');
    const { initSnapRail } = await import('@valtier/ds/motion/snap-rail');
    const { initAllDotReveals } = await import('@valtier/ds/motion/dot-reveal');
    const { isPhone, prefersReducedMotion } = await import('@valtier/ds/motion/env');
    const { whenNear } = await import('@valtier/ds/motion/inview');
    await window.vIdle();

    const section = document.querySelector<HTMLElement>('[data-pace]');
    if (section) whenNear(section, () => window.vDefer(() => init(section)));
    function init(root: HTMLElement) {
      initAllDotReveals(root);
      const track = root.querySelector<HTMLElement>('[data-pace-track]')!;
      const sets = Array.from(root.querySelectorAll<HTMLElement>('[data-pace-set]'));
      const ensureSrc = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) v.src = v.dataset.src; };

      if (isPhone()) {
        // One looping snap rail: 3 copies of the clips, centred card active.
        root.classList.add('is-rail');
        const list = sets[0];
        const items = Array.from(list.children);
        const before = items.map((n) => n.cloneNode(true) as HTMLElement);
        const after = items.map((n) => n.cloneNode(true) as HTMLElement);
        list.prepend(...before);
        list.append(...after);
        list.tabIndex = 0;
        initSnapRail(list, { loop: true });
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          const v = e.target.querySelector<HTMLVideoElement>('video[data-reel]');
          if (!v) return;
          if (e.isIntersecting && e.intersectionRatio >= 0.7) { ensureSrc(v); v.muted = true; v.play().catch(() => {}); } else if (!v.paused) v.pause();
        }), { threshold: [0, 0.7] });
        list.querySelectorAll('[data-pace-card]').forEach((c) => io.observe(c));
      } else {
        // Second half for the seamless loop, then repeat until one half covers the viewport.
        const twin = sets[0].cloneNode(true) as HTMLElement;
        twin.setAttribute('aria-hidden', 'true');
        twin.querySelectorAll('a').forEach((a) => (a.tabIndex = -1));
        track.append(twin);
        sets.push(twin);
        const card = root.querySelector<HTMLElement>('[data-pace-card]');
        if (card) {
          const perSet = sets[0].children.length;
          const need = Math.max(1, Math.ceil(innerWidth / (perSet * (card.offsetWidth + 32))));
          for (let k = 1; k < need; k++) sets.forEach((s) => Array.from(s.children).slice(0, perSet).forEach((n) => {
            const c = n.cloneNode(true) as HTMLElement;
            c.setAttribute('aria-hidden', 'true');
            c.querySelectorAll('a').forEach((a) => (a.tabIndex = -1));
            s.append(c);
          }));
        }
        const drift = initDrift(track, { baseSpeed: 0.35 });
        track.addEventListener('click', (e) => { if ((e as MouseEvent).detail > 0 && drift.dragDistance() > 6) e.preventDefault(); }, true);
        const reduced = prefersReducedMotion();
        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-pace-card]')).map((c) => ({ c, v: c.querySelector<HTMLVideoElement>('video[data-reel]') }));
        let raf = 0, frame = 0, on = false;
        const loop = () => {
          raf = requestAnimationFrame(loop);
          if (frame++ % 2) return;
          const w = innerWidth;
          for (const { c, v } of cards) {
            const r = c.getBoundingClientRect();
            if (!r.width) continue;
            const off = r.right < -120 || r.left > w + 120;
            if (v) {
              if (off) { if (!v.paused) v.pause(); }
              else { ensureSrc(v); if (v.paused) { v.muted = true; v.play().catch(() => {}); } }
            }
            if (reduced || off) continue;
            const s = Math.max(-1.15, Math.min(1.15, (r.left + r.width / 2 - w / 2) / (w / 2)));
            c.style.transform = `perspective(1200px) translateX(${(-90 * s * Math.abs(s)).toFixed(1)}px) translateY(${(24 * s * s).toFixed(1)}px) translateZ(${(-210 * s * s).toFixed(1)}px) rotateY(${(22 * s).toFixed(2)}deg) rotateZ(${(1.4 * s).toFixed(2)}deg)`;
          }
        };
        new IntersectionObserver(([e]) => {
          if (e?.isIntersecting) { if (!on) { on = true; raf = requestAnimationFrame(loop); } }
          else { on = false; cancelAnimationFrame(raf); cards.forEach(({ v }) => v?.pause()); }
        }, { rootMargin: '15% 0px' }).observe(root);
      }
    }
  });
</script>

<style>
  .pace { position: relative; overflow: hidden; padding: 4rem 0 2rem; }
  .pace__head { margin-inline: auto; max-width: 1240px; padding-inline: var(--gutter); }
  .pace__title { text-align: center; font-size: 20.5vw; color: var(--color-bone); }
  .pace__stage { position: relative; margin: 1.5rem 0 -2.5rem; overflow: hidden; padding-block: 2.5rem; filter: blur(0); }
  .pace__track { display: flex; width: max-content; align-items: center; }
  .pace__set { display: flex; flex-shrink: 0; align-items: center; gap: 2rem; padding-right: 2rem; }
  .pace__card { flex-shrink: 0; will-change: transform; }
  .pace__link {
    position: relative; display: block; width: 168px; height: 328px; overflow: hidden; border-radius: var(--radius-reel);
    background: var(--color-smoke); transition: transform 0.3s; user-select: none;
  }
  .pace__link:hover { transform: scale(1.06); }
  .pace__link img, .pace__link video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pace__badge {
    position: absolute; inset: auto 0 0; display: flex; align-items: flex-end; justify-content: flex-start; padding: 0.75rem;
    background: linear-gradient(to top, rgba(11, 10, 15, 0.65) 0%, rgba(11, 10, 15, 0) 60%); color: var(--color-bone);
  }
  .pace__badge :global(svg) { width: 1.25rem; height: 1.25rem; }
  .pace__dim { display: none; }
  .pace__edge { pointer-events: none; position: absolute; top: 0; bottom: 0; z-index: 10; width: clamp(110px, 20vw, 440px); }
  .pace__edge--left { left: 0; } .pace__edge--right { right: 0; }
  .pace__blur { position: absolute; inset: 0; }
  @media (hover: none) { .pace__blur--fine { display: none; } }
  .pace__social { margin-top: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 2rem; }
  .pace__social-link { display: flex; min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; color: var(--color-gold); transition: color 0.3s; }
  .pace__social-link:hover { color: var(--color-gold-bright); }
  .pace__social-link :global(svg) { width: 2.5rem; height: 2.5rem; }
  @media (min-width: 768px) {
    .pace { padding-block: min(144px, calc(10 * var(--vu))); }
    .pace__title { font-size: clamp(52px, calc(9.2 * var(--vu)), 136px); }
    .pace__link { height: min(428px, calc(53.5 * var(--of-vh))); width: min(219px, calc(27.375 * var(--of-vh))); }
    .pace__social { margin-top: 4rem; }
  }
  @media (max-width: 767px), (max-width: 900px) and (pointer: coarse) {
    .pace__stage { margin: 1.5rem 0 0; padding: 0; overflow: visible; filter: none; }
    .pace__edge { display: none; }
    .pace__track { width: auto; display: block; }
    .pace__set {
      gap: 16px; padding-inline: 24px; scroll-padding-inline: 24px; overflow-x: auto; overflow-y: hidden;
      scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
    }
    .pace__set::-webkit-scrollbar { display: none; }
    .pace__card { scroll-snap-align: center; transition: transform 550ms var(--ease-reveal); will-change: auto; }
    .is-rail .pace__card:not([aria-current='true']) { transform: scale(0.94); }
    .pace__dim { display: block; position: absolute; inset: 0; pointer-events: none; background: color-mix(in srgb, var(--color-ink) 50%, transparent); opacity: 0; transition: opacity 550ms var(--ease-reveal); }
    .is-rail .pace__card:not([aria-current='true']) .pace__dim { opacity: 1; }
  }
</style>
