---
/** Home is not designed yet — send visitors to On-Field (static redirect). */
import { withBase } from '@valtier/ds/lib/base';
const to = withBase('/on-field');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nico Valtier</title>
    <meta name="description" content="Nico Valtier — wide receiver #18." />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
  </head>
  <body style="background:#0b0a0f;color:#f4efe6;font-family:system-ui,sans-serif">
    <p style="padding:2rem"><a href={to} style="color:inherit">Continue to On-Field</a></p>
  </body>
</html>
