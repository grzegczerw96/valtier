---
import Base from '../layouts/Base.astro';
import HomeStage from '../components/home/HomeStage.astro';
import QuotePhotos from '../components/home/QuotePhotos.astro';
import Partnerships from '../components/home/Partnerships.astro';
import MakeAPlay from '../components/home/MakeAPlay.astro';
import { hero, moments } from '../content/home';
import { footerVariants } from '../site.config';
---
<Base
  title="Nico Valtier · Wide Receiver #18"
  description="Nico Valtier, wide receiver #18 of the Northmark Wolves: signature moments, partnerships and the Valtier 18 Foundation."
  theme="tone-light"
  footer={footerVariants.onField}
  preload={[
    { href: hero.portrait.still, as: 'image', type: 'image/webp', fetchpriority: 'high' },
    { href: moments.items[0].image, as: 'image', type: 'image/webp' },
  ]}
>
  <HomeStage />
  <QuotePhotos />
  <Partnerships />
  <MakeAPlay />
</Base>
