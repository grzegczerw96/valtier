---
/** Collectible card face: image + specular sweep (follows --mxf) + iridescent
 *  colour-dodge + inner ring, all scaled by --hover (0..1). The 3D pose comes from
 *  CSS variables set by motion/tilt.ts or a page timeline:
 *    --tz --rx --ry-cursor --ry-pos --rz --scale (and --hover / --mxf).
 *  `back` renders a mirrored face for cards that spin through 180°. */
interface Props {
  src: string;
  alt?: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  back?: boolean;
}
const { src, alt = '', width, height, class: cls, loading = 'lazy', fetchpriority, back = false } = Astro.props;
---
<div class:list={['tilt-face', back && 'tilt-face--back', cls]}>
  <div class="tilt-face__clip">
    <img src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding="async" draggable="false" />
    <span class="tilt-face__sheen" aria-hidden="true"></span>
    <span class="tilt-face__iris" aria-hidden="true"></span>
  </div>
  <span class="tilt-face__ring" aria-hidden="true"></span>
</div>

<style is:global>
  .tilt-face { position: absolute; inset: 0; border-radius: 4%; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .tilt-face--back { transform: rotateY(180deg); }
  .tilt-face__clip { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 4%; }
  .tilt-face__clip img { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .tilt-face__sheen, .tilt-face__iris, .tilt-face__ring { position: absolute; inset: 0; pointer-events: none; }
  .tilt-face__sheen {
    background: var(--sheen-sweep);
    background-size: 260% 100%; background-position-x: calc(var(--mxf, .5) * 100%);
    mix-blend-mode: screen; opacity: calc(.85 * var(--hover, 0)); transition: opacity .25s ease;
  }
  .tilt-face--back .tilt-face__sheen {
    background-image: var(--sheen-sweep-back);
    background-position-x: calc((1 - var(--mxf, .5)) * 100%);
  }
  .tilt-face__iris {
    background: linear-gradient(115deg, rgba(120,90,255,.16) 0%, rgba(255,120,200,0) 38%, rgba(255,180,90,0) 62%, rgba(90,200,255,.16) 100%);
    mix-blend-mode: color-dodge; opacity: calc(.7 * var(--hover, 0)); transition: opacity .3s ease;
  }
  .tilt-face--back .tilt-face__iris { background-image: linear-gradient(245deg, rgba(120,90,255,.16) 0%, rgba(255,120,200,0) 38%, rgba(255,180,90,0) 62%, rgba(90,200,255,.16) 100%); }
  .tilt-face__ring {
    border-radius: 4%;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,calc(.5 * var(--hover, 0))), inset 0 0 calc(18px * var(--hover, 0)) rgba(255,255,255,calc(.18 * var(--hover, 0)));
    transition: box-shadow .25s ease;
  }
  /* Shared 3D body + drop shadow that deepens with --hover. */
  .tilt-body {
    position: relative; width: 100%; height: 100%; transform-style: preserve-3d; will-change: transform;
    transform: translateZ(var(--tz, 0px)) rotateX(var(--rx, 0deg)) rotateY(calc(var(--ry-pos, 0deg) + var(--ry-cursor, 0deg))) rotateZ(var(--rz, 0deg)) scale(var(--scale, 1));
    transition: transform .2s cubic-bezier(.22, 1, .36, 1);
    filter: drop-shadow(0 calc(8px + 26px * var(--hover, 0)) calc(16px + 34px * var(--hover, 0)) rgba(0,0,0,calc(.28 + .32 * var(--hover, 0))));
  }
</style>
