---
/** Typographic logo stand-in (the system ships no third-party marks). Height is
 *  driven by --wm-h (the cap box); `scale` adjusts optical size per mark. */
import type { Partner } from '../lib/types';
interface Props { name: string; style: Partner['style']; scale?: number; tracking?: string; weight?: number; italic?: boolean; color?: string; class?: string; label?: boolean }
const { name, style, scale = 1, tracking, weight, italic, color, class: cls, label = true } = Astro.props;
const css = [`--s:${scale}`, tracking && `letter-spacing:${tracking}`, weight && `font-weight:${weight}`, italic && 'font-style:italic', color && `color:${color}`].filter(Boolean).join(';');
---
<span class:list={['wm', `wm--${style}`, cls]} style={css} role={label ? 'img' : undefined} aria-label={label ? name : undefined} aria-hidden={label ? undefined : 'true'}>{name}</span>

<style is:global>
  .wm { display: inline-flex; align-items: center; height: var(--wm-h, 28px); flex-shrink: 0; white-space: nowrap; line-height: 1; font-size: calc(var(--wm-h, 28px) * 0.92 * var(--s, 1)); }
  .wm--display { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; font-size: calc(var(--wm-h, 28px) * 1.22 * var(--s, 1)); }
  .wm--body { font-family: var(--font-body); font-weight: 800; letter-spacing: -0.03em; }
  .wm--mono { font-family: var(--font-mono); font-weight: 500; text-transform: uppercase; letter-spacing: 0.18em; font-size: calc(var(--wm-h, 28px) * 0.72 * var(--s, 1)); }
  .wm--hero { font-family: var(--font-hero); text-transform: uppercase; }
  .wm--serif { font-family: Georgia, 'Times New Roman', serif; letter-spacing: -0.01em; }
</style>
