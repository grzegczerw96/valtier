---
/** Fixed page background: theme colour, pebble-leather grain (multiply) and the
 *  footer leather (overlay) that fades in with --fdp. */
---
<div class="bg-layers" aria-hidden="true">
  <div class="bg-layers__base"></div>
  <div class="bg-layers__texture bg-layers__texture--multiply"></div>
  <div class="bg-layers__texture bg-layers__texture--footer"></div>
</div>
