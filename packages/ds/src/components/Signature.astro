---
/** Hand-drawn signature that writes itself (stroke-dashoffset) when `data-active`
 *  turns true and un-writes when it turns false. Hovering replays it quickly. */
interface Props { class?: string; color?: string; label?: string }
const { class: cls, color = 'var(--color-lavender)', label = 'Signature' } = Astro.props;
---
<div class:list={['sig', cls]} data-signature data-active="false" role="img" aria-label={label} style={`--sig-color:${color}`}>
  <svg viewBox="0 0 320 144" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <path pathLength="1" class="sig__p sig__p1" d="M34 112c10-30 24-70 36-86 6-8 10-6 8 4-5 24-16 58-22 82 12-30 30-66 46-84 7-8 10-4 7 6-7 26-15 50-17 72 0 6 4 7 8 2 10-14 22-36 30-52" />
    <path pathLength="1" class="sig__p sig__p2" d="M150 56c-6 18-8 34-2 40 6 7 18-6 26-22 6-12 10-24 12-32-6 22-10 46-8 58 2 10 10 6 16-4 12-20 26-42 44-54 8-6 14-4 12 4" />
    <path pathLength="1" class="sig__p sig__p3" d="M58 128c54-8 128-14 222-22" />
  </svg>
</div>

<script>
  window.vDefer(async () => {
    const { prefersReducedMotion } = await import('../motion/env');
    await window.vIdle();
    document.querySelectorAll<HTMLElement>('[data-signature]').forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || el.dataset.active !== 'true' || prefersReducedMotion() || el.dataset.replay) return;
        el.dataset.replay = 'out';
        setTimeout(() => (el.dataset.replay = 'in'), 180);
        setTimeout(() => delete el.dataset.replay, 900);
      });
    });
  });
</script>

<style is:global>
  .sig { pointer-events: auto; }
  .sig svg { width: 100%; height: 100%; overflow: visible; }
  .sig__p { stroke: var(--sig-color); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.5s cubic-bezier(0.55, 0.1, 0.3, 1); }
  .sig[data-active='true'] .sig__p { stroke-dashoffset: 0; }
  .sig[data-active='true'] .sig__p1 { transition-duration: 0.62s; }
  .sig[data-active='true'] .sig__p2 { transition-duration: 0.55s; transition-delay: 0.55s; }
  .sig[data-active='true'] .sig__p3 { transition-duration: 0.35s; transition-delay: 1.05s; }
  .sig[data-replay='out'] .sig__p { stroke-dashoffset: 1; transition: stroke-dashoffset 0.16s linear; }
  .sig[data-replay='in'] .sig__p { transition-duration: 0.22s; }
  .sig[data-replay='in'] .sig__p2 { transition-delay: 0.2s; }
  .sig[data-replay='in'] .sig__p3 { transition-delay: 0.4s; }
  @media (prefers-reduced-motion: reduce) { .sig__p { transition: none; } }
</style>
