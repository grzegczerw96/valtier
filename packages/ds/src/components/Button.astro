---
/** Pill CTA. Hover: the pill grows (x1.12, 200ms), an arched fill rises from
 *  below (200ms) and the label springs down to .82 (320ms overshoot). */
type Variant = 'light' | 'dark' | 'secondary' | 'cta' | 'gold';
type Size = 'sm' | 'md' | 'lg';
interface Props { href?: string; external?: boolean; variant?: Variant; size?: Size; grow?: boolean; class?: string; [k: string]: unknown }
const { href, external = false, variant = 'light', size = 'sm', grow = true, class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...(external ? { target: '_blank', rel: 'noreferrer' } : {}) } : { type: 'button' };
---
<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, grow && 'btn--grow', 'heading', cls]} {...attrs} {...rest}>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    position: relative; isolation: isolate; display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden; border-radius: var(--radius-pill); text-transform: uppercase;
    line-height: 1.05; letter-spacing: 0.02em;
    transition: box-shadow 200ms var(--ease-ui), color 200ms var(--ease-ui), scale 200ms var(--ease-ui);
  }
  .btn--sm { padding: 1rem 2rem; font-size: 14px; }
  .btn--md { padding: 18px 3rem; font-size: 18px; }
  .btn--lg { padding: 2rem 5rem; font-size: 24px; }
  .btn--light { background: var(--color-bone); color: var(--color-ink-deep); --btn-fill: var(--color-cta-yellow); --btn-glow: var(--color-cta-yellow); }
  .btn--dark { background: var(--color-ink-deep); color: var(--color-bone); --btn-fill: var(--color-purple-rich); --btn-glow: var(--color-purple-rich); }
  .btn--secondary { background: transparent; color: var(--color-bone); box-shadow: inset 0 0 0 1px rgba(246, 243, 239, 0.45); --btn-fill: var(--color-cta-yellow); --btn-glow: var(--color-cta-yellow); }
  .btn--cta { background: var(--color-cta-yellow); color: var(--color-ink-deep); --btn-fill: var(--color-lavender); --btn-glow: var(--color-purple-rich); }
  .btn--gold { background: var(--color-gold); color: var(--color-ink-deep); --btn-fill: var(--color-cta-yellow); --btn-glow: var(--color-cta-yellow); }
  .btn--grow:hover { scale: 1.12; box-shadow: 0 12px 34px -12px color-mix(in oklab, var(--btn-glow) 58%, transparent); }
  .btn--grow:active { scale: 1.06; }
  .btn--cta:hover, .btn--cta:active { color: #000; }
  .btn__fill {
    position: absolute; z-index: -1; pointer-events: none; inset: -40% -15% 0;
    background: var(--btn-fill); border-radius: 50% 50% 0 0 / 42% 42% 0 0;
    translate: 0 calc(100% + 1px); transition: translate 200ms var(--ease-ui);
  }
  .btn:hover .btn__fill, .btn:active .btn__fill { translate: 0 0; }
  .btn__label {
    position: relative; z-index: 1; display: inline-block; white-space: nowrap;
    transition: scale 320ms var(--ease-spring), color 200ms var(--ease-ui), translate 200ms var(--ease-ui);
  }
  .btn--lg .btn__label { translate: 0 0.05em; }
  .btn:hover .btn__label, .btn:active .btn__label { scale: 0.82; }
  .btn:not(.btn--dark):hover .btn__label { color: var(--color-ink); }
</style>
