---
/** Phone mock-up playing a vertical clip under a generic short-video UI (status
 *  bar, feed tabs, action rail, caption, tab bar). Frame proportions 346:733.
 *  The clip (muted loop) is attached by motion code via `data-src`; without it the
 *  poster shows. */
interface Props { poster: string; video?: string; alt: string; handle?: string; caption?: string; likes?: string; class?: string; eager?: boolean }
const { poster, video, alt, handle = '@nicovaltier', caption = '', likes = '24.1K', class: cls, eager } = Astro.props;
const gid = `phone-shade-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['phone', cls]}>
  <div class="phone__body">
    <div class="phone__screen">
      <img class="phone__media" src={poster} alt={video ? '' : alt} width="540" height="960" loading={eager ? 'eager' : 'lazy'} decoding="async" draggable="false" />
      {video && <video class="phone__media" muted loop playsinline disableremoteplayback preload="none" poster={poster} data-src={video} aria-label={alt} data-phone-video></video>}
      <div class="phone__bar" aria-hidden="true"></div>
      <svg class="phone__ui" viewBox="0 0 346 733" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#000" stop-opacity=".38" />
            <stop offset=".12" stop-color="#000" stop-opacity="0" />
            <stop offset=".7" stop-color="#000" stop-opacity="0" />
            <stop offset=".9" stop-color="#000" stop-opacity=".45" />
          </linearGradient>
        </defs>
        <rect width="346" height="733" fill={`url(#${gid})`} />
        <g fill="#fff" font-family="var(--font-body)">
          <text x="28" y="27" font-size="12" font-weight="700">12:22</text>
          <rect x="284" y="18" width="18" height="9" rx="2.4" fill="none" stroke="#fff" stroke-width="1.3" />
          <rect x="286.2" y="20.2" width="11" height="4.6" rx="1" />
          <path d="M262 27h2.6v-3H262zm4-1.6h2.6v4.6H266zm4-3h2.6v7.6H270zm4-3h2.6v10.6H274z" transform="translate(0 -2)" />
          <text x="173" y="62" font-size="12.5" font-weight="600" text-anchor="middle"><tspan fill-opacity=".62">Following</tspan><tspan dx="10" fill-opacity=".4">|</tspan><tspan dx="10">For You</tspan></text>
          <rect x="183" y="68" width="22" height="2" rx="1" />
          <g transform="translate(312 330)">
            <circle r="16" fill="#2a2730" stroke="#fff" stroke-width="1.5" />
            <path d="M-5 2a5 5 0 0 1 10 0v5h-10zM0 -9a4 4 0 1 1 0 8a4 4 0 1 1 0-8" fill="#d8d2c8" />
            <circle cy="17" r="6.5" fill="#9E6DE9" />
            <path d="M-3 17h6M0 14v6" stroke="#fff" stroke-width="1.6" />
          </g>
          <g transform="translate(312 384)"><path d="M0 9-11-2a6.5 6.5 0 0 1 11-7 6.5 6.5 0 0 1 11 7z" /><text y="26" font-size="9.5" font-weight="700" text-anchor="middle">{likes}</text></g>
          <g transform="translate(312 436)"><path d="M-11-7a11 9 0 1 1 6 15l-7 3 2-6a9 9 0 0 1-1-12z" /><text y="26" font-size="9.5" font-weight="700" text-anchor="middle">1,208</text></g>
          <g transform="translate(312 488)"><path d="M-8-10h16v21l-8-6-8 6z" /><text y="26" font-size="9.5" font-weight="700" text-anchor="middle">3,941</text></g>
          <g transform="translate(312 540)"><path d="M2-10 12 0 2 10V4c-8 0-12 2-15 7 1-9 6-14 15-15z" /><text y="26" font-size="9.5" font-weight="700" text-anchor="middle">Share</text></g>
          <text x="18" y="600" font-size="12.5" font-weight="800">{handle}</text>
          <text x="18" y="618" font-size="11" fill-opacity=".92">{caption}</text>
          <g fill-opacity=".95">
            <path d="M34 684l9-8 9 8v9h-6v-6h-6v6h-6z" />
            <text x="43" y="707" font-size="7.5" text-anchor="middle">Home</text>
            <circle cx="108" cy="684" r="7" fill="none" stroke="#fff" stroke-width="1.8" /><path d="M113 689l5 5" stroke="#fff" stroke-width="1.8" />
            <text x="110" y="707" font-size="7.5" text-anchor="middle" fill-opacity=".7">Discover</text>
            <rect x="157" y="674" width="32" height="21" rx="6" />
            <path d="M173 679v11M167.5 684.5h11" stroke="#141216" stroke-width="2.2" />
            <path d="M228 677h18v13h-12l-6 4z" fill="none" stroke="#fff" stroke-width="1.8" />
            <text x="237" y="707" font-size="7.5" text-anchor="middle" fill-opacity=".7">Inbox</text>
            <circle cx="303" cy="680" r="5" fill="none" stroke="#fff" stroke-width="1.8" /><path d="M294 693a9 7 0 0 1 18 0" fill="none" stroke="#fff" stroke-width="1.8" />
            <text x="303" y="707" font-size="7.5" text-anchor="middle" fill-opacity=".7">Profile</text>
          </g>
        </g>
      </svg>
      <div class="phone__notch" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style is:global>
  .phone { position: relative; aspect-ratio: 346 / 733; }
  .phone__body {
    position: absolute; inset: 0; border-radius: 15% / 7.1%; background: #0b0a0c;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(244, 239, 230, 0.1);
  }
  .phone__screen { position: absolute; inset: 1.9%; overflow: hidden; border-radius: 13.4% / 6.4%; background: #141216; }
  .phone__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .phone__bar { pointer-events: none; position: absolute; inset-inline: 0; bottom: 0; height: 10.3%; background: #000; }
  .phone__ui { pointer-events: none; position: absolute; inset: 0; width: 100%; height: 100%; }
  .phone__notch { pointer-events: none; position: absolute; left: 50%; top: 0; width: 54%; height: 3.9%; transform: translateX(-50%); background: #0b0a0c; border-radius: 0 0 18px 18px; }
</style>
