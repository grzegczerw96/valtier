---
/** Valtier brand mark — a "V" of two blades under a diamond (37 x 43 grid).
 *  `fillable` renders the loader variant: a dim mark plus a rect that rises
 *  through a clip of the same shapes (driven by transitions.ts). */
export const LOGO_PATHS = [
  'M18.5 0 23.6 5.6 18.5 11.2 13.4 5.6Z',
  'M0 9.6h9.7l8.8 23.9L15.2 43Z',
  'M37 9.6h-9.7l-6 16.2 3.7 9.3Z',
];
interface Props { class?: string; fillable?: boolean; solid?: boolean; label?: string; idSuffix?: string }
const { class: cls, fillable = false, solid = false, label = 'Valtier', idSuffix = 'a' } = Astro.props;
const clipId = `logo-fill-${idSuffix}`;
---
{fillable ? (
  <svg viewBox="0 0 37 43" width="37" height="43" class={cls} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
    <defs><clipPath id={clipId}>{LOGO_PATHS.map((d) => <path d={d} />)}</clipPath></defs>
    <g fill="var(--logo-fill, #F6F3EF)" opacity={solid ? 1 : 0.18}>{LOGO_PATHS.map((d) => <path d={d} />)}</g>
    <rect data-logo-fill x="0" y="43" width="37" height="0" fill="var(--logo-fill, #F6F3EF)" clip-path={`url(#${clipId})`} />
  </svg>
) : (
  <svg viewBox="0 0 37 43" width="37" height="43" class={cls} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg" fill="currentColor">
    {LOGO_PATHS.map((d) => <path d={d} />)}
  </svg>
)}
